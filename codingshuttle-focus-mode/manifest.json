{
  "manifest_version": 3,
  "name": "CodingShuttle Focus Mode",
  "version": "2.0.0",
  "description": "Distraction-free reading on codingshuttle.com: focus mode, reading progress, pomodoro, highlighter, inline notes, floating TOC, copy-code, and mark-as-done.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["*://*.codingshuttle.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.codingshuttle.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
